# -----------------------------------------------------------------------------
# OS / editor
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Pipeline run logs (each run rewrites this; the Markdown reports are the artifact)
pipeline/output/*.log

# uv lockfile — pyproject.toml's version floors are sufficient for v1; revisit
# if/when CI or other contributors arrive
pipeline/uv.lock

# -----------------------------------------------------------------------------
# Environment / secrets
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example

# -----------------------------------------------------------------------------
# Python (pipeline/)
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# The Python build-artifact ignores above (notably the unanchored `lib/`) would
# otherwise swallow the Next.js runtime's source directory. Keep it tracked.
!runtime/src/lib/
!runtime/src/lib/**

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/

# Jupyter
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Node / Next.js (runtime/)
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
build/
dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/cache
.yarn/install-state.gz
.yarn-integrity

# Testing
coverage/
.nyc_output/

# Misc
*.tsbuildinfo
next-env.d.ts
.vercel

# Saved Figma Make prototype export (reference only, not tracked)
docs/temp/
